# TrustGuard AI Environment Configuration

# Flask Application Secret Key (generate a secure random string for production)
SECRET_KEY=trustguard-secret-key-change-in-production

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=trustguard_db

# File Upload Settings
MAX_CONTENT_LENGTH=5242880  # 5 MB maximum upload limit
UPLOAD_FOLDER=uploads

# Tesseract OCR Path (leave blank if on system PATH or use standard Windows installation path)
# Default for 64-bit Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
