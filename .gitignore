# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# ── Virtual environments ───────────────────────────────────────────────────────
venv/
env/
.env/
.venv/

# ── Secrets & environment config ──────────────────────────────────────────────
# .env is excluded; .env.example (safe placeholder) is explicitly allowed.
*.env
!.env.example

# ── Uploads (user-supplied files; keep directory stub only) ───────────────────
uploads/*
!uploads/.gitkeep

# ── Application logs ──────────────────────────────────────────────────────────
*.log
logs/

# ── Temporary & OS files ──────────────────────────────────────────────────────
*.tmp
*.swp
*.bak
.DS_Store
Thumbs.db
Desktop.ini

# ── IDE & editor directories ──────────────────────────────────────────────────
.vscode/
.idea/
*.iml

# ── Type-checker & static-analysis config (machine-specific) ─────────────────
# pyrefly.toml stores an absolute Windows interpreter path unique to each
# developer's machine and has no meaning for other contributors.
pyrefly.toml

# ── Kilo IDE workspace state ───────────────────────────────────────────────────
# .kilo/ contains local session and workspace metadata generated by the Kilo
# editor. It is machine-specific and should not be published.
.kilo/

# ── ML dataset (excluded pending licence verification) ────────────────────────
# ml/dataset.csv is excluded from the public repository because its
# redistribution terms have not yet been verified. Run ml/download_dataset.py
# to obtain it from the official UCI repository before training.
# ml/model.pkl and ml/vectorizer.pkl are intentionally included (committed).
ml/dataset.csv
